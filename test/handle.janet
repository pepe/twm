(use spork/test)
(import ../twm/thicket :prefix "")
(import ../twm/handle)
(import gp/tui)

(def psk (string/repeat "k" 32))
(def url "localhost:45871")
(def view @{:focused "Write the invoice" :state :focused})
(setdyn :view view)
(def manager (make-manager @{:view view}))
(:transact manager (^rpc url handle/membrane/funcs psk :symbiont false))
(ev/go (fn [] (:await manager)))
(ev/sleep 0.2)

(def config {:rpc url :name :handle :psk psk})
(def client (handle/connect config 10))

(start-suite :handle-view)
(assert (deep= @{:focused "Write the invoice" :state :focused}
               (:handle/view client [:focused :state]))
        "the view is given by the keys asked")
(end-suite)

(start-suite :handle-watch)
(def token (:handle/watch client [:focused]))
(assert (string? token) "a watch is named")
(assert (get-in view [:handle/watches token]) "and kept in the view")
(assert (deep= @[] (:handle/await client token 0.2))
        "an await with nothing sent gives nothing back")
(:transact manager (^notify/send :focused))
(assert (deep= @[:focused] (:handle/await client token 1))
        "a topic sent before the await is not lost")
(ev/spawn (ev/sleep 0.2) (:transact manager (^notify/send :focused)))
(assert (deep= @[:focused] (:handle/await client token 2))
        "a topic sent during the await ends it")
(:transact manager (^notify/send stage/stand-down))
(assert (= :stand-down (:handle/await client token 1))
        "the symbiont leaving is told")
(assert-error "an unknown watch is refused"
              (:handle/await client "nope" 1))
(def client (handle/connect config 10))
(:handle/unwatch client token)
(assert (nil? (get-in view [:handle/watches token])) "unwatch closes it")
(assert (all |(not (index-of token $)) (values (view :notify)))
        "and takes it off every topic")
(end-suite)

(start-suite :handle-lapse)
(def old (:handle/watch client [:state]))
(put-in view [:handle/watches old :seen] 0)
(def new (:handle/watch client [:state]))
(assert (nil? (get-in view [:handle/watches old])) "a watch long unawaited lapses")
(assert (get-in view [:handle/watches new]) "the new one stays")
(end-suite)

(start-suite :handle-quick)
(def- key-event (get-in (require "../twm/handle") ['^key :value]))
(defn- press
  "Presses `keys` on `state`, and returns what the last one watches."
  [state & keys]
  (var watched nil)
  (each k keys
    (def e (key-event k))
    ((e :update) e state)
    (set watched ((e :watch) e state nil)))
  watched)
(defn- line [state] (tui/editor/text (state :editor)))
(def state @{:app {:quick {"b" "/b"}} :input? false
             :editor (tui/make-editor {:prompt "> "})})
(press state {:key :char :text "b"} {:key :char :text "3"})
(assert (and (state :input?) (= "/b3" (line state)))
        "a quick key begins its line, typed on")
(assert (indexed? (press state {:key :enter}))
        "Enter alone submits it")
(assert (and (not (state :input?)) (= "" (line state)))
        "and the line is left, empty")
(press state {:key :char :text "b"} {:key :esc})
(assert (and (not (state :input?)) (= "" (line state)))
        "Esc takes a quick line away")
(press state {:key :char :text "i"} {:key :char :text "x"} {:key :enter})
(assert (and (state :input?) (= "x\n" (line state)))
        "a line not begun by a quick key breaks on Enter")
(var planning false)
(def state @{:app {:quick (fn [] (if planning {"3" "3"} {"b" "/b"}))}
             :input? false :editor (tui/make-editor {:prompt "> "})})
(press state {:key :char :text "3"})
(assert (not (state :input?)) "a quick key given by a function, when it gives it")
(set planning true)
(press state {:key :char :text "3"})
(assert (and (state :quick) (= "3" (line state))) "asked again at every key")
(end-suite)

(start-suite :handle-mouse)
(def- spans (get-in (require "../twm/handle") ['spans :value]))
(defn- left [row col] {:key :mouse :button 0 :press true :row row :col col})
(def state @{:app {:click (fn [_ i] (if (= i 3) "/f3"))}
             :view @{} :input? false :scroll 1 :flex [4 10]
             :editor (tui/make-editor {:prompt "> "})
             :explained ""
             :explanation {:lines [["Use " {:text " $mtb " :style :cyan}]]
                           :choices [{:text "$mtb " :at [0 1]}]}})
(put state :spans (spans state 1))
(assert (deep= @[{:row 1 :from 6 :to 12 :choice 0}] (state :spans))
        "a button of the cloud is found where it is drawn")
(press state (left 2 8))
(assert (and (state :input?) (= "$mtb " (line state)))
        "a click on it takes it into the line")
(tui/editor/set (state :editor) "")
(assert (indexed? (press state (left 7 1)))
        "a click on a line of the block submits what the app makes of it")
(assert (nil? (press state (left 8 1))) "and one on a line it makes nothing of does not")
(assert (nil? (press state (merge (left 7 1) {:press false})))
        "nor does letting go")
(end-suite)

(os/exit 0)
