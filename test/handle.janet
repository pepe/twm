(use spork/test)
(import ../twm/thicket :prefix "")
(import ../twm/handle)
(import gp/tui)

(def psk (string/repeat "k" 32))
(def url "localhost:45871")
(def view @{:focused "Write the invoice" :state :focused})
(setdyn :view view)
(def manager (make-manager @{:view view}))
(:transact manager (^rpc url handle/membrane/funcs psk :symbiont false))
(ev/go (fn [] (:await manager)))
(ev/sleep 0.2)

(def config {:rpc url :name :handle :psk psk})
(def client (handle/connect config 10))

(start-suite :handle-view)
(assert (deep= @{:focused "Write the invoice" :state :focused}
               (:handle/view client [:focused :state]))
        "the view is given by the keys asked")
(end-suite)

(start-suite :handle-watch)
(def token (:handle/watch client [:focused]))
(assert (string? token) "a watch is named")
(assert (get-in view [:handle/watches token]) "and kept in the view")
(assert (deep= @[] (:handle/await client token 0.2))
        "an await with nothing sent gives nothing back")
(:transact manager (^notify/send :focused))
(assert (deep= @[:focused] (:handle/await client token 1))
        "a topic sent before the await is not lost")
(ev/spawn (ev/sleep 0.2) (:transact manager (^notify/send :focused)))
(assert (deep= @[:focused] (:handle/await client token 2))
        "a topic sent during the await ends it")
(:transact manager (^notify/send stage/stand-down))
(assert (= :stand-down (:handle/await client token 1))
        "the symbiont leaving is told")
(assert-error "an unknown watch is refused"
              (:handle/await client "nope" 1))
(def client (handle/connect config 10))
(:handle/unwatch client token)
(assert (nil? (get-in view [:handle/watches token])) "unwatch closes it")
(assert (all |(not (index-of token $)) (values (view :notify)))
        "and takes it off every topic")
(end-suite)

(start-suite :handle-lapse)
(def old (:handle/watch client [:state]))
(put-in view [:handle/watches old :seen] 0)
(def new (:handle/watch client [:state]))
(assert (nil? (get-in view [:handle/watches old])) "a watch long unawaited lapses")
(assert (get-in view [:handle/watches new]) "the new one stays")
(end-suite)

(start-suite :handle-quick)
(def- key-event (get-in (require "../twm/handle") ['^key :value]))
(defn- press
  "Presses `keys` on `state`, and returns what the last one watches."
  [state & keys]
  (var watched nil)
  (each k keys
    (def e (key-event k))
    ((e :update) e state)
    (set watched ((e :watch) e state nil)))
  watched)
(defn- line [state] (tui/editor/text (state :editor)))
(def- editor/opts (get-in (require "../twm/handle") ['editor/opts :value]))
(defn- editor [] (tui/make-editor editor/opts))
(def state @{:app {:quick {"b" "/b"}} :input? false :editor (editor)})
(press state {:key :char :text "b"} {:key :char :text "3"})
(assert (and (state :input?) (= "/b3" (line state)))
        "a quick key begins its line, typed on")
(assert (indexed? (press state {:key :enter}))
        "Enter alone submits it")
(assert (and (not (state :input?)) (= "" (line state)))
        "and the line is left, empty")
(press state {:key :char :text "b"} {:key :esc})
(assert (and (not (state :input?)) (= "" (line state)))
        "Esc takes a quick line away")
(press state {:key :char :text "i"} {:key :char :text "x"} {:key :alt-enter})
(assert (and (state :input?) (= "x\n" (line state)))
        "Alt+Enter breaks the line")
(assert (indexed? (press state {:key :char :text "y"} {:key :enter :shift true}))
        "Enter, Shift too, submits a line typed from i")
(assert (and (not (state :input?)) (= "" (line state)))
        "and leaves it, for the dashboard to have the keys")
(press state {:key :char :text "i"} {:key :char :text " "})
(assert (and (nil? (press state {:key :enter})) (state :input?))
        "a blank line is not submitted")
(press state {:key :char :text "x"} {:key :esc})
(assert (and (not (state :input?)) (= "" (line state)))
        "Esc cancels a line typed from i as well")
(assert (indexed? (press state {:key :char :text "b"} {:key :ctrl-enter}))
        "Ctrl+Enter submits as Enter does")
(assert (and (not (state :input?)) (= "" (line state))) "and leaves the line")
(var planning false)
(def state @{:app {:quick (fn [] (if planning {"3" "3"} {"b" "/b"}))}
             :input? false :editor (editor)})
(press state {:key :char :text "3"})
(assert (not (state :input?)) "a quick key given by a function, when it gives it")
(set planning true)
(press state {:key :char :text "3"})
(assert (and (state :input?) (= "3" (line state))) "asked again at every key")
(end-suite)

(start-suite :handle-cloud)
(defn- clouded [text]
  (def ed (editor))
  (tui/editor/set ed text)
  @{:app {} :input? true :editor ed :explained text
    :explanation {:lines [["a" "b"]]
                  :choices [{:text "/b1" :at [0 0]} {:text "/b2" :at [0 1]}]}})
(def state (clouded "/b"))
(press state {:key :tab})
(assert (= 0 (state :choice)) "Tab takes the focus to the cloud, its first button")
(press state {:key :tab} {:key :tab})
(assert (= 0 (state :choice)) "Tab again goes on to the next, round to the first")
(press state {:key :tab :shift true})
(assert (and (nil? (state :choice)) (state :input?) (= "/b" (line state)))
        "Shift+Tab gives the focus back to the line, as it was")
(press state {:key :tab} {:key :esc})
(assert (and (nil? (state :choice)) (state :input?) (= "/b" (line state)))
        "and so does Esc, the line kept")
(press state {:key :tab} {:key :tab} {:key :enter})
(assert (and (nil? (state :choice)) (state :input?) (= "/b2" (line state)))
        "Enter on a button takes it into the line, and submits nothing")
(assert (indexed? (press state {:key :enter})) "Enter in the line then submits it")
(press state {:key :tab :shift true})
(assert (nil? (state :choice)) "Shift+Tab in the line picks nothing")
(end-suite)

(start-suite :handle-mouse)
(def- spans (get-in (require "../twm/handle") ['spans :value]))
(defn- left [row col] {:key :mouse :button 0 :press true :row row :col col})
(def state @{:app {:click (fn [_ i] (if (= i 3) "/f3"))}
             :view @{} :input? false :scroll 1 :flex [4 10]
             :editor (tui/make-editor {:prompt "> "})
             :explained ""
             :explanation {:lines [["Use " {:text " $mtb " :style :cyan}]]
                           :choices [{:text "$mtb " :at [0 1]}]}})
(put state :spans (spans state 1))
(assert (deep= @[{:row 1 :from 6 :to 12 :choice 0}] (state :spans))
        "a button of the cloud is found where it is drawn")
(press state (left 2 8))
(assert (and (state :input?) (= "$mtb " (line state)))
        "a click on it takes it into the line")
(tui/editor/set (state :editor) "")
(assert (indexed? (press state (left 7 1)))
        "a click on a line of the block submits what the app makes of it")
(assert (nil? (press state (left 8 1))) "and one on a line it makes nothing of does not")
(assert (nil? (press state (merge (left 7 1) {:press false})))
        "nor does letting go")
(put state :left 30)
(assert (nil? (press state (left 7 40)))
        "a click beside the console, on the aside, does nothing")
(end-suite)

(start-suite :handle-hold)
(def- b {:key :char :text "b"})
(defn- hold
  "Holds `k` on `state` for `secs`, repeating it as a terminal does, and
  returns what was submitted."
  [state k secs]
  (var submitted nil)
  (repeat (math/ceil (/ secs 0.05))
    (ev/sleep 0.05)
    (if-let [w (press state k)] (set submitted w)))
  submitted)
(def state @{:app {:quick {"b" "/b" "3" "3"} :hold {"b" true}}
             :input? false :editor (editor)})
(press state b)
(assert (and (state :input?) (= "/b" (line state)) (nil? (hold state b 0.5)))
        "a held key is not typed again, nor submitted before its time")
(assert (indexed? (hold state b 0.4)) "held long enough, it submits its line")
(assert (and (not (state :input?)) (= "" (line state))) "and leaves it")
(hold state b 0.5)
(assert (and (not (state :input?)) (= "" (line state)))
        "its repeats after are let go")
(ev/sleep 0.4)
(press state b)
(assert (and (state :input?) (= "/b" (line state))) "pressed again it begins its line")
(press state {:key :esc})
(press state b)
(ev/sleep 0.8)
(assert (and (nil? (press state b)) (state :input?) (= "/b" (line state)))
        "let go and pressed again, it is not held")
(press state {:key :esc} {:key :char :text "3"})
(hold state {:key :char :text "3"} 0.1)
(assert (and (state :input?) (= "333" (line state)))
        "a quick key not of `:hold` is typed again as it repeats")
(end-suite)

(start-suite :handle-aside)
(def aside ["TODAY" "Tracked     2h 14m"])
(assert (= 58 (handle/aside/width aside 80))
        "the aside takes its widest line, a margin and the rule")
(assert (nil? (handle/aside/width aside 60))
        "and none when the console would be too narrow")
(assert (nil? (handle/aside/width [] 200)) "nor when there is nothing aside")
(end-suite)

(os/exit 0)
