(use spork/test)
(import ../twm/artifact)
(import gp/atomic)
(import spork/path)

(start-suite :atomic-artifacts)
(def dir (path/join (or (os/getenv "TEMP") "/tmp") (string "twm-artifact-" (os/getpid))))
(os/mkdir dir)
(def built (path/join dir "built"))
(def installed (path/join dir "installed"))
(atomic/write built "version one")
(assert-error "unidentified builds cannot be installed" (artifact/install built installed))
(artifact/record built {:source {:revision "one"} :configuration "test"})
(artifact/install built installed)
(def active (artifact/read-installed installed))
(assert (= :verified (active :status)))
(atomic/write built "version two")
(assert (= :unverified (get (artifact/read-installed built) :status)) "stale sidecar is not trusted")
(artifact/record built {:source {:revision "two"} :configuration "test"})
(artifact/install built installed)
(assert (= "version two" (string (slurp installed))))
(assert (= "one" (get-in active [:source :revision])) "installed changes do not rewrite active identity")
(assert (= "two" (get-in (artifact/read-installed installed) [:source :revision])))
(assert-error "failed copy preserves the installed artifact" (atomic/copy (path/join dir "absent") installed))
(assert (= "version two" (string (slurp installed))))
(assert (= (artifact/fingerprint @{:b 2 :a 1}) (artifact/fingerprint @{:a 1 :b 2})))
(assert (not= (artifact/fingerprint {:a 1}) (artifact/fingerprint {:a 2})))
(each name [built installed (string built ".provenance.jdn") (string installed ".provenance.jdn")]
  (os/rm name))
(os/rmdir dir)
(end-suite)
