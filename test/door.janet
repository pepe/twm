(use spork/test)
(import ../twm/thicket :prefix "")
(import ../twm/yarlyk :prefix "")
(import ../twm/door :prefix "")
(import ../twm/sentry :as sentry)

(def baskak (yarlyk/keygen))
(def now (os/time))

(defn warrant [&opt over at]
  (yarlyk/issue (merge {:issuer "locker/baskak" :avatar "locker/dan"
                        :capability :admin :consequence :session/open
                        :door "interstudy/dan-sentry"}
                       (or over {}))
                (baskak :secret-key) 60 (or at now)))

(defn guardian []
  (def place @{:name :dan :guards :dan :address "https://dan.admin.example"
               :view @{}})
  @{:name :dan-sentry :thicket "interstudy"
    :spaces @{:dan place}
    :door/issuers [(baskak :public-key)]
    :door/admits [{:avatar "locker/dan" :admin true}
                  {:avatar "locker/eve" :viewer true}]})

(defn recording []
  (def calls @{:publish @[] :handover @[]})
  [calls
   {:publish (fn [& args] (array/push (calls :publish) args))
    :handover (fn [place] (array/push (calls :handover) (place :name)))}])

(start-suite :door-admit)
(def state (guardian))
(def [calls ops] (recording))
(def functions (door/functions state ops))
(def admit (functions :entry/admit))
(def answer (admit nil (warrant)))
(assert (dictionary? answer) "a warranted, admitted avatar gets in")
(assert (= 64 (length (answer :token))))
(assert (= "https://dan.admin.example" (answer :address)))
(def [token owner how] (first (calls :publish)))
(assert (= token (answer :token)) "the token given is the session published")
(assert (= :dan-sentry owner) "under the door's owner")
(assert (deep= {:holder "locker/dan"} how) "held by the avatar")
(assert (empty? (calls :handover)) "a place nobody is listening on is not handed over")
(def second (admit nil (warrant)))
(assert (not= (answer :token) (second :token)) "each admission is a session of its own")
(assert (= 2 (length (calls :publish))))
(end-suite)

(start-suite :door-refusals)
(def state (guardian))
(def [calls ops] (recording))
(def admit ((door/functions state ops) :entry/admit))
(assert (= [:refused :not-admitted] (admit nil (warrant {:avatar "locker/matej"})))
        "an avatar this door does not admit stays out, however warranted")
(assert (= [:refused :capability] (admit nil (warrant {:avatar "locker/eve"})))
        "an avatar admitted as a viewer is not let in as an admin")
(assert (= [:refused :door] (admit nil (warrant {:door "interstudy/matej-sentry"})))
        "a warrant for another door does not open this one")
(assert (= [:refused :signature]
           (admit nil (yarlyk/issue {:avatar "locker/dan" :capability :admin
                                     :consequence :session/open
                                     :door "interstudy/dan-sentry"}
                                    ((yarlyk/keygen) :secret-key) 60 now)))
        "a warrant from an issuer the door does not trust")
(assert (= [:refused :expired] (admit nil (warrant nil (- now 120)))))
(assert (= [:refused :before-start] (admit nil (warrant nil (- now 30))))
        "a warrant older than the door is refused")
(def once (warrant))
(assert (dictionary? (admit nil once)))
(assert (= [:refused :replayed] (admit nil once)) "a warrant opens the door once")
(assert (= [:refused :malformed] (admit nil "please")))
(assert (= 1 (length (calls :publish))) "no refusal publishes anything")
(end-suite)

(start-suite :door-end)
(def state (guardian))
(def [calls ops] (recording))
(def end ((door/functions state ops) :entry/end))
(assert (= :ok (end nil "locker/dan")))
(assert (deep= ["" :dan-sentry {:holder "locker/dan"}] (tuple ;(first (calls :publish))))
        "ending is ending every session the avatar holds here, and only those")
(assert (= [:refused :unknown-avatar] (end nil "locker/matej")))
(assert (= :ok (end nil "locker/dan" "tok-1")))
(assert (deep= ["" :dan-sentry {:holder "locker/dan" :token "tok-1"}]
               (tuple ;(last (calls :publish))))
        "one token ends, and only as the avatar's own")
(assert (= [:refused :malformed] (end nil "locker/dan" "")))
(import ../twm/tree :as tree)
(def live @{})
(tree/sessions/record live "a" :dan-sentry {:holder "locker/dan"})
(tree/sessions/record live "b" :dan-sentry {:holder "locker/dan"})
(tree/sessions/record live "p" :dan-sentry {:holder "password"})
(tree/sessions/record live "" :dan-sentry {:holder "locker/dan" :token "p"})
(assert (get-in live [:dan-sentry "p"]) "an avatar cannot end a session it does not hold")
(tree/sessions/record live "" :dan-sentry {:holder "locker/dan" :token "a"})
(assert (deep= @{"b" "locker/dan" "p" "password"} (live :dan-sentry))
        "its own one ends, and its others stay")
(end-suite)

(start-suite :door-shape)
(def two (guardian))
(put-in two [:spaces :todo] @{:name :todo :address "https://dan.admin.example/todo/"})
(assert (string/find "name the one an Avatar lands on" (last (protect (door/place two))))
        "a guardian of several places is never given the first of them")
(put two :door/place :dan)
(assert (= :dan ((door/place two) :name)) "it lands where it says")
(put two :door/place :track)
(assert (string/find "no place track" (last (protect (door/place two)))))
(put two :door/place :dan)
(put-in two [:spaces :todo :owner] :matej)
(assert (string/find "different owners" (last (protect (door/place two))))
        "one session cannot open places of two owners")
(def both (guardian))
(put both :identities {:dan {}})
(assert (string/find "identities and a door" (last (protect (door/place both)))))
(assert (= "interstudy/dan-sentry" (door/id (guardian))))
(end-suite)

(start-suite :door-rpc)
(def url "localhost:45877")
(def psk (door/psk "parent" "locker" "interstudy" "dan-sentry"))
(def state (guardian))
(def [calls ops] (recording))
(def manager (make-manager state))
(:transact manager (^rpc url (door/functions state ops) psk "dan-sentry door" false))
(ev/sleep 0.2)
(def client (rpc/client ;(server/host-port url) "avatar" psk))
(assert (= :pong (:ping client)))
# Issued now, not when the file was read: a door refuses a warrant older
# than itself, and a second may have passed since.
(def answer (:entry/admit client (warrant nil (os/time))))
(assert (dictionary? answer) "a warrant crosses the door's own listener")
(assert (= (answer :token) (get-in calls [:publish 0 0])))
(:close client)
(def [ok _] (protect (ev/with-deadline 2
                       (def c (rpc/client ;(server/host-port url) "eve" "wrong key"))
                       (:ping c))))
(assert (not ok) "without the relation's key there is no knocking")
(end-suite)

(start-suite :door-cookie-only)
(def sessions @{})
(import ../twm/tree :as tree)
(tree/sessions/record sessions "tok-dan" :dan-sentry {:holder "locker/dan"})
(tree/sessions/record sessions "tok-pw" :dan-sentry {:holder "password"})
(tree/sessions/record sessions "tok-matej" :matej-sentry {:holder "locker/matej"})
(def dan-cap (tree/session/cap (sessions :dan-sentry)))
(assert (= "locker/dan" (dan-cap {:headers {"Cookie" {"session" "tok-dan"}}}))
        "the session a door gave opens the place as its cookie")
(assert (dan-cap {:headers {"Cookie" {"session" "tok-pw"}}}) "a password session beside it")
(assert (not (dan-cap {:headers {"Authorization" "Bearer tok-dan"}}))
        "a bearer opens nothing, a live one neither")
(assert (not (dan-cap {:headers {"Cookie" {"session" "tok-matej"}}}))
        "Matej's token opens nothing of Dan's")
(assert (not (dan-cap {:headers {}})))
(tree/sessions/record sessions "" :dan-sentry {:holder "locker/dan"})
(def after (tree/session/cap (sessions :dan-sentry)))
(assert (not (after {:headers {"Cookie" {"session" "tok-dan"}}})) "an ended token is refused")
(assert (after {:headers {"Cookie" {"session" "tok-pw"}}}) "and nobody else's ended")
(end-suite)

(start-suite :door-own-page)
(def origin "https://dan.locker.example")
(def place @{:name :dan :view @{}
             :origins [origin] :address "https://dan.admin.example"
             :routes @{"/courses" (fn [req] (http/success (ds/get "/courses/new")))}})
(def handler (space/handler place))
(defn ask [method uri headers] (string (handler @{:method method :uri uri :headers headers})))
(defn head [res] (slice res 0 (string/find "\r\n\r\n" res)))
(def asked (ask "GET" "/courses" {"Origin" origin}))
(assert (not (string/find "Access-Control" (head asked)))
        "a place answers no request across origins, not even from one it names")
(assert (string/has-suffix? "\r\n\r\n@get('/courses/new')" asked)
        "and renders its actions root-relative whoever asks")
(assert (not (string/has-prefix? "HTTP/1.1 204" (ask "OPTIONS" "/courses" {"Origin" origin})))
        "a preflight is not answered as one")
(assert (= "@get('/content', {requestCancellation: el.stream})"
           (ds/action-with "get" "requestCancellation: el.stream" "/content"))
        "an action's options stay its own")
(assert (= "@post('/todo/swap')" (ds/post "/todo/swap")))
(def view @{:name :dan-sentry :cap/session (fn [req] false)})
(def checked ((sentry/session/check-with "not signed in") (fn [req] (http/success "in"))))
(assert (string/has-prefix? "HTTP/1.1 401" (string (with-dyns [:view view] (checked {:headers {}}))))
        "a refused session is refused on the place's own page")
(assert (empty? (sentry/session/presented {:headers {"Authorization" "Bearer b"}}))
        "a logout ends no session a bearer names")
(import ../twm/schema :as schema)
(assert (not (schema/config/membrane/http-node? {:http "localhost:1" :origins [origin]}))
        "a place an Avatar opens must say its address")
(assert (schema/config/membrane/http-node?
          {:http "localhost:1" :origins [origin] :address "https://dan.admin.example"}))
(assert (schema/config/membrane/http-node? {:http "localhost:1" :door/css ["a.css"]})
        "a conf still naming door-scoped sheets is let be, and they are not served")
(assert (string/has-prefix? "HTTP/1.1 404" (ask "GET" "/_door.css" {})))
(end-suite)

(start-suite :door-open)
(def locker "https://locker.example")
(def opener ((door/open-route {:origins [locker] :address "https://x/"})
              "/_door/open"))
(def token (door/token))
(defn post [body &opt from]
  (string (opener {:method "POST" :body body
                   :headers (if from {"Origin" from} {})})))
(def opened (post (string "token=" token) locker))
(assert (string/find "303" opened) "a posted session sends the window to the place")
(assert (string/find "Location: https://x/" opened))
(assert (string/find (string "session=" token "; Secure; HttpOnly; Path=/;") opened)
        "with the session as the place's own cookie")
(each [from why] [["https://evil.example" "from a page it does not name"]
                  ["null" "from an origin the browser hid"]
                  [nil "from nowhere it says"]]
  (def refused (post (string "token=" token) from))
  (assert (string/find "Location: https://x/" refused) (string "a post " why " goes to the place"))
  (assert (not (string/find "Set-Cookie" refused)) (string "but sets no cookie " why)))
(def malformed (post "token=nothex" locker))
(assert (string/find "Location: https://x/" malformed) "anything else still goes to the place")
(assert (not (string/find "Set-Cookie" malformed)) "but sets no cookie")
(assert (not (string/find "Set-Cookie" (string (opener {:method "GET" :headers {"Origin" locker}}))))
        "and a GET, which a link could make, sets none either")
(assert (deep= {} (door/open-route {:address "https://x/"}))
        "no route where no Avatar may come from")
(end-suite)

(os/exit 0)
