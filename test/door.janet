(use spork/test)
(import ../twm/thicket :prefix "")
(import ../twm/yarlyk :prefix "")
(import ../twm/door :prefix "")
(import ../twm/sentry :as sentry)

(def baskak (yarlyk/keygen))
(def now (os/time))

(defn warrant [&opt over at]
  (yarlyk/issue (merge {:issuer "locker/baskak" :avatar "locker/dan"
                        :capability :admin :consequence :session/open
                        :door "interstudy/dan-sentry"}
                       (or over {}))
                (baskak :secret-key) 60 (or at now)))

(defn guardian []
  (def place @{:name :dan :guards :dan :address "https://dan.admin.example"
               :view @{}})
  @{:name :dan-sentry :thicket "interstudy"
    :spaces @{:dan place}
    :door/issuers [(baskak :public-key)]
    :door/admits [{:avatar "locker/dan" :admin true}
                  {:avatar "locker/eve" :viewer true}]})

(defn recording []
  (def calls @{:publish @[] :handover @[]})
  [calls
   {:publish (fn [& args] (array/push (calls :publish) args))
    :handover (fn [place] (array/push (calls :handover) (place :name)))}])

(start-suite :door-admit)
(def state (guardian))
(def [calls ops] (recording))
(def functions (door/functions state ops))
(def admit (functions :entry/admit))
(def answer (admit nil (warrant)))
(assert (dictionary? answer) "a warranted, admitted avatar gets in")
(assert (= 64 (length (answer :token))))
(assert (= "https://dan.admin.example" (answer :address)))
(def [token owner how] (first (calls :publish)))
(assert (= token (answer :token)) "the token given is the session published")
(assert (= :dan-sentry owner) "under the door's owner")
(assert (deep= {:holder "locker/dan"} how) "held by the avatar")
(assert (empty? (calls :handover)) "a place nobody is listening on is not handed over")
(def second (admit nil (warrant)))
(assert (not= (answer :token) (second :token)) "each admission is a session of its own")
(assert (= 2 (length (calls :publish))))
(end-suite)

(start-suite :door-refusals)
(def state (guardian))
(def [calls ops] (recording))
(def admit ((door/functions state ops) :entry/admit))
(assert (= [:refused :not-admitted] (admit nil (warrant {:avatar "locker/matej"})))
        "an avatar this door does not admit stays out, however warranted")
(assert (= [:refused :capability] (admit nil (warrant {:avatar "locker/eve"})))
        "an avatar admitted as a viewer is not let in as an admin")
(assert (= [:refused :door] (admit nil (warrant {:door "interstudy/matej-sentry"})))
        "a warrant for another door does not open this one")
(assert (= [:refused :signature]
           (admit nil (yarlyk/issue {:avatar "locker/dan" :capability :admin
                                     :consequence :session/open
                                     :door "interstudy/dan-sentry"}
                                    ((yarlyk/keygen) :secret-key) 60 now)))
        "a warrant from an issuer the door does not trust")
(assert (= [:refused :expired] (admit nil (warrant nil (- now 120)))))
(assert (= [:refused :before-start] (admit nil (warrant nil (- now 30))))
        "a warrant older than the door is refused")
(def once (warrant))
(assert (dictionary? (admit nil once)))
(assert (= [:refused :replayed] (admit nil once)) "a warrant opens the door once")
(assert (= [:refused :malformed] (admit nil "please")))
(assert (= 1 (length (calls :publish))) "no refusal publishes anything")
(end-suite)

(start-suite :door-end)
(def state (guardian))
(def [calls ops] (recording))
(def end ((door/functions state ops) :entry/end))
(assert (= :ok (end nil "locker/dan")))
(assert (deep= ["" :dan-sentry {:holder "locker/dan"}] (tuple ;(first (calls :publish))))
        "ending is ending every session the avatar holds here, and only those")
(assert (= [:refused :unknown-avatar] (end nil "locker/matej")))
(end-suite)

(start-suite :door-shape)
(def two (guardian))
(put-in two [:spaces :matej] @{:name :matej})
(assert (string/find "exactly one place" (last (protect (door/place two)))))
(def both (guardian))
(put both :identities {:dan {}})
(assert (string/find "identities and a door" (last (protect (door/place both)))))
(assert (= "interstudy/dan-sentry" (door/id (guardian))))
(end-suite)

(start-suite :door-rpc)
(def url "localhost:45877")
(def psk (door/psk "parent" "locker" "interstudy" "dan-sentry"))
(def state (guardian))
(def [calls ops] (recording))
(def manager (make-manager state))
(:transact manager (^rpc url (door/functions state ops) psk "dan-sentry door" false))
(ev/sleep 0.2)
(def client (rpc/client ;(server/host-port url) "avatar" psk))
(assert (= :pong (:ping client)))
(def answer (:entry/admit client (warrant)))
(assert (dictionary? answer) "a warrant crosses the door's own listener")
(assert (= (answer :token) (get-in calls [:publish 0 0])))
(:close client)
(def [ok _] (protect (ev/with-deadline 2
                       (def c (rpc/client ;(server/host-port url) "eve" "wrong key"))
                       (:ping c))))
(assert (not ok) "without the relation's key there is no knocking")
(end-suite)

(start-suite :door-bearer)
(def sessions @{})
(import ../twm/tree :as tree)
(tree/sessions/record sessions "tok-dan" :dan-sentry {:holder "locker/dan"})
(tree/sessions/record sessions "tok-pw" :dan-sentry {:holder "password"})
(tree/sessions/record sessions "tok-matej" :matej-sentry {:holder "locker/matej"})
(def dan-cap (tree/session/cap (sessions :dan-sentry)))
(assert (dan-cap {:headers {"Authorization" "Bearer tok-dan"}}) "the Avatar's bearer")
(assert (dan-cap {:headers {"Cookie" {"session" "tok-pw"}}}) "a password session beside it")
(assert (not (dan-cap {:headers {"Authorization" "Bearer tok-matej"}}))
        "Matej's token opens nothing of Dan's")
(assert (not (dan-cap {:headers {"Authorization" "tok-dan"}})) "a bare token is no bearer")
(assert (not (dan-cap {:headers {}})))
(tree/sessions/record sessions "" :dan-sentry {:holder "locker/dan"})
(def after (tree/session/cap (sessions :dan-sentry)))
(assert (not (after {:headers {"Authorization" "Bearer tok-dan"}})) "an ended token is refused")
(assert (after {:headers {"Cookie" {"session" "tok-pw"}}}) "and nobody else's ended")
(end-suite)

(start-suite :cors)
(def origin "https://dan.locker.example")
# Handlers answer as gp's do: rendered bytes, head and all.
(defn handler [req] (http/success "hi" {"Content-Type" "text/plain"}))
(def wrapped (cors/wrap handler [origin]))
(def pre (string (wrapped {:method "OPTIONS" :headers {"Origin" origin}})))
(assert (string/has-prefix? "HTTP/1.1 204" pre) "the preflight is answered, as bytes a server writes")
(assert (string/find (string "Access-Control-Allow-Origin: " origin "\r\n") pre))
(assert (string/find "Access-Control-Allow-Headers: Authorization" pre))
(assert (not (string/find "Access-Control-Allow-Credentials" pre)) "no credentials cross")
(def got (string (wrapped {:method "GET" :headers {"Origin" origin}})))
(def got-head (slice got 0 (string/find "\r\n\r\n" got)))
(assert (string/find (string "Access-Control-Allow-Origin: " origin) got-head)
        "a rendered response's head carries the headers")
(assert (string/find "Content-Type: text/plain" got-head) "beside its own")
(assert (string/has-suffix? "\r\n\r\nhi" got) "and its body is untouched")
(def other (string (wrapped {:method "GET" :headers {"Origin" "https://evil.example"}})))
(assert (not (string/find "Access-Control-Allow-Origin" other))
        "another origin is answered as before, and the browser keeps it out")
(assert (= (string (handler {})) (string (wrapped {:method "GET" :headers {}})))
        "a same-origin request is untouched")
(def written @[])
(def conn @{:write (fn [self s] (array/push written (string s)) self)
            :flush (fn [self] self) :close (fn [self] self)})
(def streamed (cors/wrap (fn [req] (http/stream (:write (dyn :sse-conn) "event: x\n\n")))
                         [origin]))
((streamed {:method "GET" :headers {"Origin" origin}}) conn)
(def head (first written))
(assert (string/find "Access-Control-Allow-Origin: https://dan.locker.example\r\n" head)
        "a stream's own head carries the headers")
(assert (string/has-suffix? "\r\n\r\n" head) "and still ends where a head ends")
(assert (string/find "event: x" (string/join written)) "and the stream flows on")
(end-suite)

(start-suite :door-actions)
(def origin "https://dan.locker.example")
(def rendered (cors/wrap (fn [req] (http/success (ds/get "/courses/new")))
                         [origin] "https://dan.admin.example"))
(defn body [res] (def s (string res)) (slice s (+ 4 (string/find "\r\n\r\n" s))))
(assert (= "@get('https://dan.admin.example/courses/new', {headers: {Authorization: 'Bearer ' + $_bearer}})"
           (body (rendered {:method "GET" :headers {"Origin" origin}})))
        "an action rendered for an Avatar names the place and carries the bearer")
(def own (fn [] (body (rendered {:method "GET" :headers {}}))))
(assert (= "@get('/courses/new')" (own))
        "rendered for the place's own page it is what it always was")
(assert (= "@get('/content', {requestCancellation: el.stream})"
           (ds/action-with "get" "requestCancellation: el.stream" "/content"))
        "an action's options stay its own")
(setdyn :door/address "https://dan.admin.example")
(assert (= "@get('https://dan.admin.example/content', {requestCancellation: el.stream, headers: {Authorization: 'Bearer ' + $_bearer}})"
           (ds/action-with "get" "requestCancellation: el.stream" "/content"))
        "and the bearer joins them for an Avatar")
(setdyn :door/address nil)
(import ../twm/schema :as schema)
(assert (not (schema/config/membrane/http-node? {:http "localhost:1" :origins [origin]}))
        "a place letting origins in must say its address")
(assert (schema/config/membrane/http-node?
          {:http "localhost:1" :origins [origin] :address "https://dan.admin.example"}))
(end-suite)

(os/exit 0)
