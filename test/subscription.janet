(use spork/test)
(import ../twm/subscription :as sub)
(import ../twm/readiness)
(start-suite :durable-coalescing)
(def view @{})
(def watcher (sub/open view [:a :b :c :stop] :stop))
(repeat 1000 (sub/publish view :a) (sub/publish view :b) (sub/publish view :c))
(assert (= 1 (ev/count (watcher :wake))) "thousands of notices need one wake token")
(assert (= 3 (length (watcher :pending))))
(sub/publish view :stop)
(assert (= :stop (sub/take watcher)) "shutdown bypasses queued data")
(def seen @{})
(repeat 3 (put seen (sub/take watcher) true))
(assert (= 3 (length seen)) "every dirty topic is eventually read")
(sub/publish view :a)
(assert (= :a (sub/take watcher)) "subscription survives rendering without re-registering")
(sub/close watcher)
(sub/close watcher)
(assert (= 0 (sub/count view)) "disconnect removes all topics")
(assert (nil? (sub/take watcher)))
(end-suite)

(start-suite :readiness-outcomes)
(def done (ev/chan 1))
(ev/go (fn [] (ev/give done (protect (readiness/await view 1)))))
(ev/sleep 0.01)
(readiness/settle view :ready)
(assert (= [true true] (ev/take done)))
(assert (readiness/await view))
(def failed @{})
(readiness/settle failed :failed "offline")
(assert-error "failure is not a ready projection" (readiness/await failed))
(def timed @{})
(assert-error "cold wait is bounded" (readiness/await timed 0.01))
(readiness/settle timed :ready)
(assert (readiness/await timed) "cancelled waiter cannot block subsequent readiness")
(end-suite)
