(use spork/test)
(import ../twm/thicket :prefix "")
(import ../twm/readiness)

(start-suite :notify)
(def view @{})
(def manager (make-manager @{:view view}))
(def topics [:a :b :c stage/stand-down])
(def chan (ev/chan (inc (length topics))))
(:transact manager (^notify/subscribe view chan ;topics))
(assert (deep= @[chan] (get-in view [:notify :a]))
        "a reader is subscribed to each of its topics")
(repeat 1000
  (:transact manager (^notify/send :a) (^notify/send :b) (^notify/send :c)))
(assert (= (dec (ev/capacity chan)) (ev/count chan))
        "a full channel is passed over rather than waited on, its last slot left free")
(:transact manager (^notify/send stage/stand-down))
(assert (= (ev/capacity chan) (ev/count chan)) "the leaving always finds its slot")
(assert (= [stage/stand-down] (notify/take chan topics))
        "and is read alone, ahead of the data")
(:transact manager (^notify/send :b) (^notify/send :b))
(assert (deep= @[:b] (notify/take chan topics)) "a topic sent twice is read once")
(:transact manager (^notify/send :a) (^notify/send :a) (^notify/send :a))
(:transact manager (^notify/send :c))
(assert (deep= @[:a :b :c] (notify/take chan topics))
        "a channel that filled gives back every data topic, the dropped one too")
(:transact manager (^notify/send :a))
(assert (deep= @[:a] (notify/take chan topics)) "the subscription outlives a read")
(:transact manager (^notify/unsubscribe view chan))
(assert (all empty? (values (view :notify)))
        "unsubscribing takes the reader off every topic")
(:transact manager (^notify/send :a))
(assert (zero? (ev/count chan)) "and nothing reaches it after")
(ev/give chan nil)
(assert (nil? (notify/take chan topics)) "nil says the reader is gone")
(end-suite)

(start-suite :readiness-outcomes)
(def gated @{})
(def done (ev/chan 1))
(ev/go (fn [] (ev/give done (protect (readiness/await gated 1)))))
(ev/sleep 0.01)
(readiness/settle gated :ready)
(assert (= [true true] (ev/take done)))
(assert (readiness/await gated))
(def failed @{})
(readiness/settle failed :failed "offline")
(assert-error "failure is not a ready projection" (readiness/await failed))
(def timed @{})
(assert-error "cold wait is bounded" (readiness/await timed 0.01))
(readiness/settle timed :ready)
(assert (readiness/await timed) "cancelled waiter cannot block subsequent readiness")
# The endpoint is asked before a symbiont has installed its view, and an
# answer of "not yet" is the truth; raising there is read as a refusal.
(def absent (readiness/status nil))
(assert (not (absent :ready)) "a place without a view is not ready")
(assert (= :pending (absent :status)) "and says so rather than raising")
(end-suite)
